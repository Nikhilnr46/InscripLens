<mxfile host="app.diagrams.net"><diagram name="Implemented architecture" id="architecture"><mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1080"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="INSCRIPLENS — IMPLEMENTED SYSTEM ARCHITECTURE" style="text;html=1;fontSize=30;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="0" width="1400" height="50" /></mxCell><mxCell id="local" value="Local computer • 127.0.0.1:8000" style="text;html=1;fontSize=20;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="63" width="440" height="40" /></mxCell><mxCell id="user" value="&lt;b&gt;Researcher / reviewer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload image or select demo&lt;br&gt;Inspect and suggest readings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="90" width="320" height="100" /></mxCell><mxCell id="ui" value="&lt;b&gt;React Studio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Original / mask viewer&lt;br&gt;Candidate inspector and review&lt;br&gt;Run history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="70" width="380" height="140" /></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local API and static frontend&lt;br&gt;Coordinates existing Python modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="280" width="380" height="130" /></mxCell><mxCell id="enhance" value="&lt;b&gt;Preparation &amp;amp; enhancement&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate, orient, resize&lt;br&gt;Reused Shilalekhya Attention U-Net&lt;br&gt;Separate PyTorch CPU worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ef;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="520" width="380" height="155" /></mxCell><mxCell id="loc" value="&lt;b&gt;Candidate localization&lt;/b&gt;&lt;br&gt;&lt;br&gt;Connected components on mask&lt;br&gt;Proposed character bounding boxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="520" width="380" height="155" /></mxCell><mxCell id="rec" value="&lt;b&gt;Character recognition&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mask crop → HOG → saved SVM&lt;br&gt;Labels and ranked alternatives&lt;br&gt;Implemented; accuracy experimental" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="520" width="380" height="155" /></mxCell><mxCell id="db" value="&lt;b&gt;SQLite database&lt;/b&gt;&lt;br&gt;&lt;br&gt;runs  •  character_reviews&lt;br&gt;Original prediction + review provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="800" width="380" height="130" /></mxCell><mxCell id="files" value="&lt;b&gt;Local files&lt;/b&gt;&lt;br&gt;&lt;br&gt;Images, masks and crops&lt;br&gt;Batch prediction JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#50657a;fontColor=#19324b;fontSize=19;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="800" width="380" height="130" /></mxCell><mxCell id="e0" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=1