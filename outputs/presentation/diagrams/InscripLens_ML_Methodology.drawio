<mxfile host="app.diagrams.net"><diagram name="INSCRIPLENS — ML METHODOLOGY AND PROCESS FLOW" id="InscripLens_ML_Methodology"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="INSCRIPLENS — ML METHODOLOGY AND PROCESS FLOW" style="text;html=1;fontSize=32;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="0" width="1500" height="65" /></mxCell><mxCell id="e0" value="" edge="1" parent="1" source="data" target="features" style="edgeStyle=none;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=1.0;exitY=0.496551724137931;entryX=0.0;entryY=0.496551724137931;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="" edge="1" parent="1" source="features" target="fit" style="edgeStyle=none;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=1.0;exitY=0.496551724137931;entryX=0.0;entryY=0.496551724137931;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="" edge="1" parent="1" source="fit" target="model" style="edgeStyle=none;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="label2" value="Refit and save" style="text;html=1;fontSize=22;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="1160" y="279" width="360" height="35" /></mxCell><mxCell id="e3" value="" edge="1" parent="1" source="model" target="eval" style="edgeStyle=none;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=0.0;exitY=0.496551724137931;entryX=1.0;entryY=0.496551724137931;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="" edge="1" parent="1" source="model" target="runtime" style="edgeStyle=none;strokeColor=#42566c;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=1.0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1340" y="555" /><mxPoint x="260" y="555" /></Array></mxGeometry></mxCell><mxCell id="label4" value="Load saved model for inference" style="text;html=1;fontSize=22;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="558" width="360" height="35" /></mxCell><mxCell id="data" value="&lt;b&gt;Annotated inscription data&lt;/b&gt;&lt;br&gt;&lt;br&gt;EpiSAM images and source labels&lt;br&gt;Filter records and exclude&lt;br&gt;validation locations from training" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="100" width="420" height="145" /></mxCell><mxCell id="features" value="&lt;b&gt;Prepare recognition features&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pretrained foreground masks&lt;br&gt;Source-box crops → median filter&lt;br&gt;32 × 32 normalization → HOG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ef;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="100" width="420" height="145" /></mxCell><mxCell id="fit" value="&lt;b&gt;Fit and assess on development&lt;/b&gt;&lt;br&gt;&lt;br&gt;Location-based fit / development&lt;br&gt;Fixed HOG + SVM baseline&lt;br&gt;Record comparisons and errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="100" width="420" height="145" /></mxCell><mxCell id="model" value="&lt;b&gt;Saved deployed recognizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Refit on 9,925 training crops&lt;br&gt;Mask HOG + SVM bundle&lt;br&gt;Raw source-label predictions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="360" width="420" height="145" /></mxCell><mxCell id="eval" value="&lt;b&gt;Diagnostic validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Supplied boxes: 77 / 300 correct&lt;br&gt;Automatic localization + label:&lt;br&gt;52 / 300 references recovered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="360" width="420" height="145" /></mxCell><mxCell id="runtime" value="&lt;b&gt;Application inference&lt;/b&gt;&lt;br&gt;&lt;br&gt;New image → mask → candidates&lt;br&gt;HOG + saved SVM → suggestions&lt;br&gt;Human review; no auto-retraining" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="360" width="420" height="145" /></mxCell><mxCell id="experiments" value="&lt;b&gt;Separate offline experiments&lt;/b&gt;&lt;br&gt;&lt;br&gt;CNN / frozen ResNet18 comparisons&lt;br&gt;Original + mask HOG: development gain; validation pending&lt;br&gt;CNN–BiLSTM–CTC: 3 / 4 sanity gate; not deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="625" width="700" height="140" /></mxCell><mxCell id="planned" value="&lt;b&gt;Unimplemented objectives&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reliable full-line transcription and reading order&lt;br&gt;Modern Kannada conversion and English interpretation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#50657a;fontColor=#19324b;fontSize=23;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="625" width="680" height="140" /></mxCell><mxCell id="note0" value="Validation is reused; source labels are unreviewed and binarizer pretraining overlap is unresolved." style="text;html=1;fontSize=23;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="807" width="1500" height="35" /></mxCell><mxCell id="note1" value="Amber = offline experiments. Grey = future objectives. Neither is part of deployed recognition." style="text;html=1;fontSize=23;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="839" width="1500" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>