  "metadata": {
    "version": "2.1",
    "title": "Documented Epigraphical Kannada Translation & Normalization Rules",
    "policy": "Unmatched words pass through unchanged and flagged as untranslated. Strict native root allowlist for phonology. No narrative guessing."
  },
  "phonological_rules": [
    {
      "id": "PHONO_P_TO_H_ALLOWLIST",
      "name": "Initial p- to h- shift",
      "method": "allowlist",
      "provenance_status": "unverified",
      "source": "Unverified - pending historical dictionary citation check",
      "context": "Documented indigenous Dravidian roots only; word-initial p- followed by vowel",
      "allowlist": {
        "pālu": "hālu",
        "palu": "halu",
        "pāḍu": "hāḍu",
        "padu": "hadu",
        "puli": "huli",
        "pū": "hū",
        "poḻal": "hoḷalu",
        "polal": "holalu",
        "pesaru": "hesaru",
        "pattu": "hattu",
        "pari": "hari",
        "poḻadu": "hoḷadu",
        "paḻa": "haḷeya",
        "pala": "halavu",
        "poge": "hoge",
        "puge": "huge",
        "poy": "hoy",
        "perame": "herame",
        "pora": "hora",
        "punise": "hunise",
        "piḍi": "hiḍi",
        "pōgu": "hōgu",
        "poṟe": "hore"
      }
    },
    {
      "id": "PHONO_RETROFLEX_MERGER",
      "name": "Archaic retroflex consonant merger",
      "provenance_status": "unverified",
      "source": "Unverified - pending historical grammar citation check",
      "context": "Orthographic normalization of archaic liquid phonemes to modern equivalents",
      "substitutions": [
        {
          "archaic": "ḻ",
          "modern": "ḷ"
        },
        {
          "archaic": "ṟ",
          "modern": "r"
        }
      ]
    }
  ],
  "case_markers": [
    {
      "id": "CASE_ACCUSATIVE_AM",
      "halegannada_pattern": "([a-zāīūṛēōḷḻṟ])am$",
      "modern_replacement": "\\1annu",
      "case_name": "Accusative (-am -> -annu)",
      "provenance_status": "unverified",
      "source": "Unverified - pending sutra citation check",
      "context": "Nominal bases functioning as direct objects in accusative case",
      "exceptions": [
        "rājyam",
        "kāḷagam",
        "dānam",
        "śāsanam",
        "puṇyam",
        "padam",
        "akkum",
        "sallakkum"
      ]
    },
    {
      "id": "CASE_ACCUSATIVE_AN",
      "halegannada_pattern": "([a-zāīūṛēōḷḻṟ])an$",
      "modern_replacement": "\\1annu",
      "case_name": "Accusative (-an -> -annu)",
      "provenance_status": "unverified",
      "source": "Unverified - pending sutra citation check",
      "context": "Masculine/rational singular direct objects",
      "exceptions": [
        "rājan",
        "brahman"
      ]
    },
    {
      "id": "CASE_INSTRUMENTAL_INDAM",
      "halegannada_pattern": "([a-zāīūṛēōḷḻṟ])indam$",
      "modern_replacement": "\\1inda",
      "case_name": "Instrumental (-indam -> -inda)",
      "provenance_status": "unverified",
      "source": "Unverified - pending sutra citation check",
      "context": "Nominal instrumental case ending",
      "exceptions": []
    },
    {
      "id": "CASE_LOCATIVE_OL",
      "halegannada_pattern": "([a-zāīūṛēōḷḻṟ])oḷ$",
      "modern_replacement": "\\1alli",
      "case_name": "Locative (-oḷ -> -alli)",
      "provenance_status": "unverified",
      "source": "Unverified - pending sutra citation check",
      "context": "Polysyllabic noun stems in locative",
      "exceptions": [
        "toḷ",
        "koḷ",
        "oḷ"
      ]
    }
  ],
  "verb_markers": [
    {
      "id": "VERB_PAST_PLURAL_DAR",
      "halegannada_pattern": "([a-zāīūṛēōḷḻṟ])(d|id)ār$",
      "modern_replacement": "\\1\\2aru",
      "category": "Past honorific 3rd plural (-dār / -idār -> -daru / -idaru)",
      "provenance_status": "unverified",
      "source": "Unverified - pending sutra citation check",
      "context": "Past tense finite verbs with dental or vocalic past infixes",
      "exceptions": [
        "kammāra",
        "sūtradhāra",
        "bēgāra"
      ]
    }
  ],
